# API Backend
# Em prod (Railway): API_URL=artemisapitemplate.railway.internal
# Em dev (local): API_URL=http://localhost:3000
API_URL=http://localhost:3000

# URL pública do front (usada pelo MP para back_urls e webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers/pt/docs/getting-started
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=...

# Webhook interno (autenticação entre webhook → backend)
WEBHOOK_INTERNAL_TOKEN=...
